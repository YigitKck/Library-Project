<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="800.0" prefHeight="500.0" style="-fx-background-color: #f4f6f8;" fx:controller="com.semy.controller.RentScreenController">

    <top>
        <VBox spacing="10.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Button text="← Geri" fx:id="backButton"
                        style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-padding: 8 16;"
                        onAction="#goToHomePage"/>
                <Label text="Kitap Kiralama" style="-fx-font-size: 26; -fx-font-weight: bold;"/>
            </HBox>
            <Separator/>
            <HBox spacing="20.0" alignment="CENTER_LEFT">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="bookTitleLabel" style="-fx-font-size: 22; -fx-font-weight: bold;"/>
                    <Label fx:id="bookAuthorLabel" style="-fx-font-size: 16; -fx-text-fill: #666666;"/>
                </VBox>
                <Label fx:id="bookStatusLabel" text="Mevcut" style="-fx-font-size: 14; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 8;">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="Kiralama Bilgileri" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <GridPane hgap="15.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="120.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Kiralama Süresi:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <ComboBox fx:id="rentalDurationCombo" promptText="Seçiniz">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="7"/>
                                <String fx:value="14"/>
                                <String fx:value="21"/>
                                <String fx:value="30"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </HBox>

                <Label text="Başlangıç Tarihi:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="startDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>

            <Separator/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
            <Button text="İptal" fx:id="cancelButton"
                    style="-fx-background-color: #f0f0f0; -fx-background-radius: 8; -fx-padding: 10 20;"
                    />
            <Button text="Kirala" fx:id="confirmButton"
                    style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;"
                    onAction="#confirmRent"
                    />
        </HBox>
    </bottom>

</BorderPane>